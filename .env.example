# Copy to .env.local and fill in. Never commit .env.local. Never paste real values into this file.
# Where to find each value: Supabase dashboard -> your project -> see README "Supabase setup".

# --- PUBLIC (shipped to the browser; safe only because RLS protects the data) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Project Settings -> Data API -> Project URL   (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# A legacy "anon" JWT also works here. The old name NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- PRIVATE (server/scripts only; never prefix with NEXT_PUBLIC_, never commit, never paste in chat) ---
# Project Settings -> API Keys -> Secret key (sb_secret_...). Used by two server actions (account deletion and the test-mode plan
# functions) and by the test scripts. Required on any deployment that uses them. The old name SUPABASE_SERVICE_ROLE_KEY is read as a fallback.
SUPABASE_SECRET_KEY=
# "false" (default): the simulated checkout is off and every plan change is refused. "true": the labelled payment SIMULATION works
# (development, and the coursework demo deployment). It never contacts a payment provider: no real payments exist.
PAYMENT_SANDBOX_ENABLED=false
